{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geo-observability",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Portal, marketing page and docs are static assets; /api, /mcp, /ingest, /share, /auth and /webhooks hit the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/ingest/*", "/share/*", "/auth/*", "/webhooks/*", "/healthz"]
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "GEO Observability",
    "AI_GATEWAY_ID": "geo-observability",
    "DEMO_MODE": "true",
    "DEMO_TENANT_SLUG": "demo",
    "JUDGE_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "OPENAI_MODEL": "gpt-5-mini",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "PERPLEXITY_MODEL": "sonar",
    "BILLING_GRACE_DAYS": "7",
    "STRIPE_AUTOMATIC_TAX": "false",
    "STRIPE_LIVE_MODE": "false"
  },

  // Billing secrets (scripts/stripe-setup.mjs prints or sets them): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // STRIPE_BILLING_CONFIG. Without them card billing and self-serve signup stay off.
  // Secrets (wrangler secret put): CLOUDFLARE_ACCOUNT_ID, CF_AIG_TOKEN, OPENAI_API_KEY, ANTHROPIC_API_KEY,
  // GEMINI_API_KEY, PERPLEXITY_API_KEY, ACCESS_TEAM_DOMAIN, ACCESS_AUD, SHARE_LINK_SECRET, OTEL_EXPORTER_URL,
  // OTEL_EXPORTER_HEADERS. Any engine without a key runs on the labelled stub engine.

  "ai": { "binding": "AI" },

  "d1_databases": [
    { "binding": "DB", "database_name": "geo-observability", "database_id": "d5137b7a-b736-4a24-bb70-697a1adf331c", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "ANSWERS", "bucket_name": "geo-observability-answers" }],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "8d42c26a723b4bae94f568b47c8f4966" }],

  "queues": {
    "producers": [{ "binding": "RUNS", "queue": "geo-observability-runs" }],
    "consumers": [
      { "queue": "geo-observability-runs", "max_batch_size": 25, "max_batch_timeout": 10, "max_retries": 3, "dead_letter_queue": "geo-observability-runs-dlq" }
    ]
  },

  "workflows": [
    { "binding": "RUN_PROMPT", "name": "geo-run-prompt", "class_name": "RunPromptWorkflow" },
    { "binding": "INSIGHTS", "name": "geo-insights", "class_name": "InsightsWorkflow" }
  ],

  "durable_objects": {
    "bindings": [{ "name": "PROGRESS", "class_name": "RunProgress" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunProgress"] }],

  "analytics_engine_datasets": [
    { "binding": "VIS_EVENTS", "dataset": "geo_visibility_events" },
    { "binding": "TRAFFIC_EVENTS", "dataset": "geo_traffic_events" }
  ],

  "triggers": {
    "crons": [
      "0 6 * * *",   // daily prompt runs
      "20 * * * *",  // hourly rollups and usage aggregation for the billing hook
      "0 9 * * *"    // daily insights and actions
    ]
  },

  "env": {
    "staging": {
      "name": "geo-observability-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_NAME": "GEO Observability (staging)",
        "AI_GATEWAY_ID": "geo-observability-staging",
        "DEMO_MODE": "true",
        "DEMO_TENANT_SLUG": "demo",
        "JUDGE_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "OPENAI_MODEL": "gpt-5-mini",
        "ANTHROPIC_MODEL": "claude-sonnet-5-5",
        "GEMINI_MODEL": "gemini-2.5-flash",
        "PERPLEXITY_MODEL": "sonar",
        "BILLING_GRACE_DAYS": "7",
        "STRIPE_AUTOMATIC_TAX": "false",
        "STRIPE_LIVE_MODE": "false"
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        { "binding": "DB", "database_name": "geo-observability-staging", "database_id": "REPLACE_WITH_STAGING_D1_ID", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "ANSWERS", "bucket_name": "geo-observability-answers-staging" }],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "REPLACE_WITH_STAGING_KV_ID" }],
      "queues": {
        "producers": [{ "binding": "RUNS", "queue": "geo-observability-runs-staging" }],
        "consumers": [
          { "queue": "geo-observability-runs-staging", "max_batch_size": 25, "max_batch_timeout": 10, "max_retries": 3 }
        ]
      },
      "workflows": [
        { "binding": "RUN_PROMPT", "name": "geo-run-prompt-staging", "class_name": "RunPromptWorkflow" },
        { "binding": "INSIGHTS", "name": "geo-insights-staging", "class_name": "InsightsWorkflow" }
      ],
      "durable_objects": { "bindings": [{ "name": "PROGRESS", "class_name": "RunProgress" }] },
      "analytics_engine_datasets": [
        { "binding": "VIS_EVENTS", "dataset": "geo_visibility_events_staging" },
        { "binding": "TRAFFIC_EVENTS", "dataset": "geo_traffic_events_staging" }
      ],
      "triggers": { "crons": ["0 6 * * *", "20 * * * *", "0 9 * * *"] }
    }
  }
}
